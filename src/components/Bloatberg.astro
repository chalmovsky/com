---
// A one-line plug for Bloatberg. Used at the end of the wtf-ubuntu post and at the top of
// the home page; delete this file and its two uses to take it down.
interface Props {
    where: 'post' | 'home';
}
const { where } = Astro.props;
---
{where === 'post' ? (
    <aside class="plug">
        <p>
            <i>Added after this blew up:</i> Can't beat all the bullshit, so I parody it at <a href="https://bloatberg.com">Bloatberg</a>.
        </p>
    </aside>
) : (
    <p class="plug">
        New: <a href="https://bloatberg.com">Bloatberg</a>, the most trusted name in
        tech news. Source: Bloatberg.
    </p>
)}
<style is:inline>
    aside.plug {
        margin-top: 2.5em;
        padding-top: 1em;
        border-top: 1px solid #8884;
    }
</style>
