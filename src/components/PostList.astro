---
import { getPosts, ymd } from '../posts';

interface Props {
  /** Show only the N newest posts. */
  limit?: number;
}
const posts = (await getPosts()).slice(0, Astro.props.limit);
---
<ul class="titles">
  {posts.map((post) => <li>{ymd(post.data.date)} <a href={`/posts/${post.id}`}>{post.data.title}</a></li>)}
</ul>
