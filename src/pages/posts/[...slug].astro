---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <div class="prose">
      <Content />
    </div>
  </article>
  <p class="back"><a href="/">&larr; All writing</a></p>
</BaseLayout>

<style>
  article h1 { margin-bottom: 0.4rem; }
  article > time { display: block; margin-bottom: 2rem; }
  .prose :global(h2) { margin-top: 2.25rem; }
  .prose :global(h3) { margin-top: 1.75rem; }
  .prose :global(> :last-child) { margin-bottom: 0; }
  .back { margin-top: 3rem; font-size: 0.9rem; }
</style>
