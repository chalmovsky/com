---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate } from '../utils/posts';

const posts = await getPublishedPosts();
---
<BaseLayout title="Chalmovský">
  <div class="intro">
    <picture>
      <source srcset="/assets/chalmovsky-200.webp" type="image/webp" />
      <img
        src="/assets/chalmovsky-200.png"
        alt=""
        width="200"
        height="200"
        class="avatar"
      />
    </picture>
    <h1>Chalmovský</h1>
    <p class="tagline">Writings from (and often to) Chalmovský</p>
  </div>

  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .intro { text-align: center; margin-bottom: 3rem; }
  .avatar {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 50%;
  }
  .intro h1 { margin-top: 1rem; font-size: 1.6rem; }
  .tagline {
    color: var(--secondary);
    font-size: 0.95rem;
    font-style: italic;
    margin-top: 0.35rem;
    margin-bottom: 0;
  }

  .posts { list-style: none; padding-left: 0; margin: 0; }
  .posts li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0;
  }
  .posts li:first-child { border-top: 1px solid var(--border); }
  .posts time { white-space: nowrap; flex-shrink: 0; font-variant-numeric: tabular-nums; }
</style>
