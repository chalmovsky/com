---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
---

<Base
    title="Chalmovský"
    description="Personal site of Chalmovský: posts on software, tools, and the occasional detour. Click the cabin."
>
    <style is:inline slot="head">
        body {
            max-width: 40em;
            margin: auto;
            padding: 1em;
            line-height: 1.5;
            position: relative;
        }
        .projects {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(15em, 1fr));
            gap: 1em;
            list-style: none;
            padding: 0;
        }
        .projects li {
            padding: 0;
        }
        .projects h3 {
            margin: 0 0 0.3em;
            font-size: 1em;
        }
        .projects p {
            margin: 0;
        }
        footer {
            margin-top: 3em;
            font-size: 0.9em;
        }
        h1 {
            margin-top: 1.4em;
        }

        /* ---- the cabin: a still picture until clicked -------------------------- */
        /* One timeline drives everything after the click (see script): it fades
           the windows and the halo in, draws the flood, and at the
           moment the page is fully consumed swaps day for night underneath it.
           Clicking again runs the same timeline backwards. */
        :root {
            --glow: #3cff6e;
        }
        /* the column of text; at night the sky behind it is dimmed so it stays readable */
        .page {
            position: relative;
            z-index: 0;
            border-radius: 3em;
        }
        .cabin:focus {
            outline: none;
        }
        .cabin:focus-visible {
            outline: 2px dashed var(--glow);
            outline-offset: 8px;
        }
        .cabin {
            display: block;
            float: right;
            width: min(16em, 46vw);
            aspect-ratio: 1;
            margin: 0.2em 0 1em 1.5em;
            position: relative;
            border: 0;
            padding: 0;
            background: none;
            cursor: pointer;
            font: inherit;
            shape-outside: margin-box;
        }
        .cabin .frame {
            display: block;
            position: absolute;
            inset: 0;
            border-radius: 12px;
            overflow: hidden;
            transform: rotate(2.5deg);
            box-shadow:
                0 0 0 1px #fff2 inset,
                0 1.5em 3em -1em #000a;
            transition: transform 1.2s cubic-bezier(0.45, 0, 0.2, 1);
        }
        .cabin img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        /* soft green blooms over the five windows */
        .cabin .windows {
            position: absolute;
            inset: 0;
            mix-blend-mode: screen;
            pointer-events: none;
            opacity: 0;
            background:
                radial-gradient(
                    10% 9% at 30.2% 61.4%,
                    var(--glow) 0 35%,
                    transparent 70%
                ),
                radial-gradient(
                    10% 9% at 44.4% 61.3%,
                    var(--glow) 0 35%,
                    transparent 70%
                ),
                radial-gradient(
                    10% 9% at 60.2% 61.3%,
                    var(--glow) 0 35%,
                    transparent 70%
                ),
                radial-gradient(
                    10% 9% at 70.4% 61.3%,
                    var(--glow) 0 35%,
                    transparent 70%
                ),
                radial-gradient(
                    10% 9% at 65.2% 46%,
                    var(--glow) 0 35%,
                    transparent 70%
                );
        }
        /* glow that bleeds from the cabin onto the page. Only its opacity ever
           changes, so it is painted once. */
        .cabin .halo {
            position: absolute;
            inset: -55%;
            z-index: -1;
            pointer-events: none;
            opacity: 0;
            transform: scale(1.4);
            will-change: opacity;
            background: radial-gradient(
                closest-side,
                color-mix(in srgb, var(--glow) 62%, transparent),
                color-mix(in srgb, var(--glow) 44%, transparent) 26%,
                color-mix(in srgb, var(--glow) 20%, transparent) 50%,
                color-mix(in srgb, var(--glow) 6%, transparent) 70%,
                transparent 88%
            );
        }
        /* the light that grows out of the windows until it has the whole page:
           a small canvas, stretched over the page by its transform, so that
           growing it costs the phone nothing to repaint. The box round it
           only keeps it from making the page wider than the screen. */
        .flood {
            position: fixed;
            inset: 0;
            z-index: 10;
            overflow: hidden;
            pointer-events: none;
            display: none;
        }
        .flood canvas {
            position: absolute;
            left: 0;
            top: 0;
            transform-origin: 0 0;
            will-change: transform, opacity;
        }

        /* 0. level: the cabin rotates straight before anything else happens */
        html.level .cabin .frame {
            transform: none;
            transition: transform 0.9s cubic-bezier(0.45, 0, 0.2, 1);
        }
        /* 1. titles pop neon as the light reaches them (the .lit class) */
        h1,
        h2 {
            transform-origin: left center;
        }
        h1,
        h2,
        .titles a,
        .projects h3 a {
            transition:
                color 0.8s,
                text-shadow 0.8s;
        }
        .lit {
            color: var(--glow) !important;
            text-shadow:
                0 0 0.12em #fff8,
                0 0 0.5em var(--glow),
                0 0 1.5em #0f6;
            animation: boom 0.6s cubic-bezier(0.2, 1.5, 0.4, 1);
        }
        a.lit {
            color: #8dffb0 !important;
            animation-name: boom-text;
        }
        @keyframes boom {
            0% {
                transform: scale(1);
                text-shadow: none;
            }
            35% {
                transform: scale(1.12);
                color: #fff !important;
                text-shadow:
                    0 0 0.3em #fff,
                    0 0 1em var(--glow),
                    0 0 2em var(--glow);
            }
            100% {
                transform: scale(1);
            }
        }
        @keyframes boom-text {
            0% {
                text-shadow: none;
            }
            35% {
                color: #fff !important;
                text-shadow:
                    0 0 0.3em #fff,
                    0 0 1em var(--glow),
                    0 0 2em var(--glow);
            }
        }
        /* 2. night, back to front: the sky and its stars, the aurora, the far snow,
           then the page, then the few flakes that pass in front of it.
           The sky is painted once; only the aurora and the snow move. */
        #night,
        #aurora,
        #far,
        #snow {
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            /* as tall as the screen ever gets, so a phone's toolbar sliding
               away never resizes them */
            height: 100vh;
            height: 100lvh;
            pointer-events: none;
            display: none;
            z-index: -2;
        }
        /* painted small and stretched over the upper sky, which is what softens it */
        #aurora {
            height: 80vh;
            height: 80lvh;
            opacity: 0.42;
        }
        #snow {
            z-index: 5;
        }
        html.night #night,
        html.night #aurora,
        html.night #far,
        html.night #snow {
            display: block;
        }
        html.night .cabin .halo {
            transform: scale(1.5);
        }
        html.night {
            color-scheme: dark;
            background: #03090d;
        }
        html.night body {
            color: #c9f7d8;
        }
        html.night a:not(.lit) {
            color: #8dffb0;
        }
        html.night footer {
            color: #7fcf97;
        }
        /* behind the text the night is dimmed a little, feathered out so there is no edge to see */
        html.night .page {
            background: rgba(3, 12, 13, 0.4);
            box-shadow: 0 0 3em 3em rgba(3, 12, 13, 0.4);
        }
        /* the cabin itself has dissolved into its own light */
        html.night .cabin img {
            opacity: 0;
        }
        html.night .cabin .frame {
            box-shadow: none;
        }
        /* touch screens: a phone paints every blurred shadow on its processor, at
           three times the pixels, so the glow is one small shadow and nothing
           about it is animated; the pop is a nudge in size and the colour */
        @media (hover: none) and (pointer: coarse) {
            h1,
            h2,
            .titles a,
            .projects h3 a {
                transition: color 0.8s;
            }
            .lit {
                text-shadow:
                    0 0 0.12em #fff6,
                    0 0 0.45em var(--glow);
                animation-name: pop;
            }
            a.lit {
                animation: none;
            }
            @keyframes pop {
                35% {
                    transform: scale(1.04);
                }
            }
            /* Safari paints nothing fixed under its toolbar, only the page's own
               background, so the sky darkens into that colour at the bottom
               edge and there is no seam */
            html.night::after {
                content: "";
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                height: 22vh;
                z-index: -1;
                pointer-events: none;
                background: linear-gradient(#03090d00, #03090dcc 62%, #03090d);
            }
        }
        @media (prefers-reduced-motion: reduce) {
            .lit {
                animation: none !important;
            }
            html * {
                transition-duration: 0.01s !important;
            }
        }
        /* phones: the cabin sits on top as a wide crop with a gentle tilt; the glow must not widen the page */
        @media (max-width: 36em) {
            html,
            body {
                overflow-x: hidden;
            }
            @supports (overflow: clip) {
                html,
                body {
                    overflow-x: clip;
                }
            }
            .cabin {
                float: none;
                width: 100%;
                aspect-ratio: 4/3;
                margin: 0.6em 0 0.4em;
            }
            .cabin .frame {
                transform: rotate(1.5deg);
            }
            /* the glow keeps inside the page's width: anything wider lets the
               page be dragged sideways */
            .cabin .halo,
            html.night .cabin .halo {
                inset: -42% 0;
                transform: none;
            }
            /* the picture is square and the frame here is not, so it is cropped
               top and bottom: the windows overlay has to be the picture's size,
               not the frame's, or the light misses the windows */
            .cabin .windows {
                inset: 50% 0 auto;
                aspect-ratio: 1;
                transform: translateY(-50%);
            }
            .page {
                border-radius: 0;
            }
            html.night .page {
                box-shadow: 0 0 2em 1em rgba(3, 12, 13, 0.4);
            }
            html.level .cabin .frame {
                transform: none;
            }
            h1 {
                margin-top: 0.9em;
            }
        }
    </style>

    <canvas id="night" aria-hidden="true"></canvas>
    <canvas id="aurora" width="200" height="110" aria-hidden="true"></canvas>
    <canvas id="far" aria-hidden="true"></canvas>
    <canvas id="snow" aria-hidden="true"></canvas>
    <div class="flood" aria-hidden="true"><canvas width="384" height="384"></canvas></div>

    <div class="page">
    <main>
        <button
            class="cabin"
            type="button"
            aria-pressed="false"
            aria-label="Toggle night mode"
            title="Click me"
        >
            <span class="halo"></span>
            <span class="frame">
                <picture>
                    <source
                        srcset="assets/chalmovsky-600.webp"
                        type="image/webp"
                    />
                    <img
                        src="assets/chalmovsky-600.jpg"
                        width="600"
                        height="600"
                        alt="A log cabin in a snowy forest at night, every window glowing green."
                        fetchpriority="high"
                        decoding="async"
                    />
                </picture>
                <span class="windows"></span>
            </span>
        </button>
        <h1>Chalmovský</h1>

        <h2 id="posts">Posts</h2>
        <PostList limit={3} />
        <p>
            <a href="posts/">All posts →</a>
        </p>

        <h2 id="projects">Projects</h2>
        <ul class="projects">
            <!-- One <li> per project:
  <li>
    <h3><a href="https://example.com">Project title</a></h3>
    <p>One or two sentences on what it is and who it is for.</p>
  </li>
  -->
            <li>
                <h3>
                    <a href="https://goodsoftware.sk">Good Software s.r.o.</a>
                </h3>
                <p>A company of mine.</p>
            </li>
            <li>
                <h3>
                    <a href="https://secondglow.app">SecondGlow</a>
                </h3>
                <p>
                    Turn your 5K iMac into an external monitor with only
                    software. Two small apps and one USB cable, and your Apple
                    silicon Mac drives the iMac as a sharp 5K display again.
                    Free for 7 days, then{" "}
                    <a href="https://secondglow.app/#pricing">buy it</a>, if you
                    like it.
                </p>
            </li>
            <li>
                <h3>
                    <a href="https://bloatberg.com">Bloatberg</a>
                </h3>
                <p>
                    Satirical tech news, built to look like a real, well-funded
                    outlet and to beat one technologically. And, of course, the
                    ultimate goal is to become the world's most-read
                    publication.{" "}
                    <a href="https://github.com/chalmovsky/bloatberg.com">
                        Open source
                    </a>
                    . Fork it for any publication: lean, fast, runs on
                    Cloudflare, almost no JavaScript for readers, CMS included.
                </p>
            </li>
            <li>
                <h3>
                    <a href="prog-lang-cup/plain/">Programming Language Cup</a>
                </h3>
                <p>
                    A programming language cup. Groups, upper and lower
                    brackets, one grand final. Every duel is the same task in
                    two languages, and you pick the winner. Smart matchmaking
                    keeps each duel fresh, so all 32 languages get a fair fight
                    across 960 snippets.{" "}
                    <a href="prog-lang-cup/plain/">Play now</a> and find your
                    favorite programming language. Feeling brave? Try the{" "}
                    <a href="prog-lang-cup/">not super tested 3D version</a>.
                    It's{" "}
                    <a href="https://github.com/chalmovsky/com/tree/main/public/prog-lang-cup">
                        open source
                    </a>{" "}
                    and runs entirely in your browser.
                </p>
            </li>
            <li>
                <h3>
                    <a href="https://github.com/chalmovsky/serverus-sshnape">
                        Serverus SSHnape
                    </a>
                </h3>
                <p>
                    Secure a VPS with one command. You type the root password
                    and the script does the rest. SSH key only, firewall,
                    fail2ban, automatic security updates, Docker kept behind the
                    firewall, swap, log caps, audit rules. Optional Telegram
                    alerts tell you about new logins, changed keys or users,
                    full disks and reboots. For Ubuntu servers, run from macOS
                    or Linux.{" "}
                    <a href="https://github.com/chalmovsky/serverus-sshnape">
                        Open source
                    </a>
                    .
                </p>
            </li>
            <li>
                <h3>
                    <a href="https://github.com/chalmovsky/snort">snort</a>
                </h3>
                <p>
                    One line and your Mac does not sleep, lid open or closed,
                    until you hit Ctrl-C. Asks for your password once, holds the
                    machine awake with a running timer, and puts every setting
                    back on exit, even when you close the terminal.{" "}
                    <a href="https://github.com/chalmovsky/snort">
                        Open source
                    </a>
                    .
                </p>
            </li>
        </ul>
    </main>

    <footer>
        <p>
            Contact: <span id="mail"></span> · <a href="feed.xml">RSS</a>
        </p>
    </footer>
    </div>

    <script is:inline>
        document.getElementById("mail").textContent = [
            "yes.upgrade887",
            "passinbox.com",
        ].join("@");

        (() => {
            const root = document.documentElement,
                cabin = document.querySelector(".cabin"),
                panes = cabin.querySelector(".windows"),
                halo = cabin.querySelector(".halo"),
                box = document.querySelector(".flood"),
                flood = box.firstElementChild;
            const titles = [
                ...document.querySelectorAll(
                    "h1, h2, .titles a, .projects h3 a",
                ),
            ];
            const still = matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            // phones and tablets draw canvases on the processor: give them fewer pixels
            const coarse = matchMedia("(hover: none) and (pointer: coarse)").matches;
            const ease = (x) => x * x * (3 - 2 * x);
            const unit = (x) => Math.min(Math.max(x, 0), 1);
            const sheet = (w, h) =>
                Object.assign(document.createElement("canvas"), {
                    width: w,
                    height: h,
                });

            // --- the night: sky, aurora and snow, drawn while it is dark ---
            const scene = (() => {
                const [sky, aur, far, front] = ["night", "aurora", "far", "snow"].map(
                    (id) => document.getElementById(id),
                );
                const b = far.getContext("2d"),
                    f = front.getContext("2d");
                let W = 0,
                    H = 0,
                    d = 1,
                    flakes = [],
                    twinkle = [],
                    live = false,
                    made = "", // the screen the canvases were last made for
                    beat = 0;

                // the same forest and the same stars every time
                const seeded = (a) => () => {
                    a = (a + 0x6d2b79f5) | 0;
                    let t = Math.imul(a ^ (a >>> 15), 1 | a);
                    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
                    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
                };

                // a soft dot: every flake is one of these, scaled
                const dot = (rgb) => {
                    const s = sheet(32, 32),
                        c = s.getContext("2d"),
                        g = c.createRadialGradient(16, 16, 0, 16, 16, 16);
                    g.addColorStop(0, `rgba(${rgb},1)`);
                    g.addColorStop(0.35, `rgba(${rgb},0.75)`);
                    g.addColorStop(1, `rgba(${rgb},0)`);
                    c.fillStyle = g;
                    c.fillRect(0, 0, 32, 32);
                    return s;
                };
                const white = dot("255,255,255"),
                    green = dot("150,255,185");

                // the aurora is painted small, one column at a time, and stretched over the sky
                const AW = aur.width,
                    AH = aur.height,
                    ac = aur.getContext("2d"),
                    ray = sheet(1, 128);
                {
                    const c = ray.getContext("2d"),
                        g = c.createLinearGradient(0, 0, 0, 128);
                    g.addColorStop(0, "rgba(40,190,170,0)");
                    g.addColorStop(0.45, "rgba(50,220,150,0.28)");
                    g.addColorStop(0.78, "rgba(100,255,150,0.85)");
                    g.addColorStop(0.88, "rgba(160,255,185,1)");
                    g.addColorStop(1, "rgba(60,255,110,0)");
                    c.fillStyle = g;
                    c.fillRect(0, 0, 1, 128);
                }
                const curtains = [
                    { y: 0.44, h: 0.5, a: 0.9, f1: 5.1, s1: 0.11, p1: 0, f2: 13, s2: 0.17, p2: 2, f3: 3.3, s3: 0.07, p3: 1 },
                    { y: 0.3, h: 0.36, a: 0.55, f1: 3.7, s1: 0.08, p1: 2.4, f2: 9, s2: 0.13, p2: 0.7, f3: 4.6, s3: 0.05, p3: 3.9 },
                    { y: 0.58, h: 0.4, a: 0.45, f1: 6.4, s1: 0.14, p1: 4.2, f2: 17, s2: 0.21, p2: 5.1, f3: 2.4, s3: 0.09, p3: 2.2 },
                ];
                const aurora = (t) => {
                    ac.clearRect(0, 0, AW, AH);
                    ac.globalCompositeOperation = "lighter";
                    for (const k of curtains)
                        for (let x = 0; x < AW; x++) {
                            const u = x / AW;
                            const hem =
                                AH *
                                (k.y +
                                    0.09 * Math.sin(u * k.f1 + t * k.s1 + k.p1) +
                                    0.04 * Math.sin(u * k.f2 - t * k.s2 + k.p2));
                            let glow =
                                0.5 + 0.5 * Math.sin(u * k.f3 + t * k.s3 + k.p3);
                            // rays: broad, slow, never finer than the columns they are painted in
                            glow *=
                                glow *
                                (0.84 +
                                    0.16 *
                                        Math.sin(u * 58 + t * 0.6 + k.p2) *
                                        Math.sin(u * 23 - t * 0.3 + k.p1));
                            const tall = AH * k.h * (0.55 + 0.45 * glow);
                            ac.globalAlpha =
                                k.a * glow * Math.sqrt(Math.sin(Math.PI * u));
                            ac.drawImage(ray, 0, 0, 1, 128, x, hem - tall, 1, tall * 1.07);
                        }
                };

                const paintSky = () => {
                    const c = sky.getContext("2d"),
                        rnd = seeded(7),
                        g = c.createLinearGradient(0, 0, 0, H);
                    g.addColorStop(0, "#03090d");
                    g.addColorStop(0.45, "#071a20");
                    g.addColorStop(0.8, "#0b2a2a");
                    g.addColorStop(1, "#0e382c");
                    c.globalAlpha = 1;
                    c.fillStyle = g;
                    c.fillRect(0, 0, W, H);
                    twinkle = [];
                    const count = Math.round((W * H) / (d * d) / 2600);
                    for (let i = 0; i < count; i++) {
                        const x = rnd() * W,
                            y = rnd() * rnd() * H * 0.85,
                            r = (0.4 + rnd() * rnd() * 1.3) * d;
                        c.globalAlpha = 0.25 + rnd() * 0.6;
                        c.fillStyle = rnd() < 0.15 ? "#c9ffe0" : "#e9f4ff";
                        c.beginPath();
                        c.arc(x, y, r, 0, 6.3);
                        c.fill();
                        if (i % 8 === 0)
                            twinkle.push({ x, y, r: r * 1.25, ph: rnd() * 6.3, sp: 0.6 + rnd() * 1.8 });
                    }
                };

                // snow: far flakes are small, slow and faint; near ones big, fast and soft
                const flake = (top) => {
                    const z = Math.pow(Math.random(), 2.1),
                        close = z > 0.86;
                    return {
                        x: Math.random() * (W + 200 * d) - 100 * d,
                        y: top ? -14 * d : Math.random() * H,
                        z,
                        close,
                        r: (0.6 + 2.4 * z * z) * (close ? 1.25 : 1) * d * (0.8 + Math.random() * 0.4),
                        v: (22 + 95 * z) * d * (0.85 + Math.random() * 0.3),
                        ph: Math.random() * 6.3,
                        w: 0.6 + Math.random() * 1.4,
                        sw: (6 + 18 * z) * d,
                        tw: Math.random() * 6.3,
                    };
                };
                const snow = (t, dt) => {
                    // the wind comes and goes in long gusts
                    const wind =
                        (10 +
                            30 *
                                (0.5 + 0.5 * Math.sin(t * 0.21)) *
                                (0.6 + 0.4 * Math.sin(t * 0.053 + 2))) *
                        d;
                    // flakes passing the cabin's light turn green
                    const c = cabin.getBoundingClientRect(),
                        gx = (c.left + c.width * 0.5) * d,
                        gy = (c.top + c.height * 0.55) * d,
                        gr = c.width * 1.5 * d;
                    f.clearRect(0, 0, W, H);
                    for (const k of flakes) {
                        k.ph += k.w * dt;
                        k.y += k.v * dt;
                        k.x += (wind * (0.35 + k.z) + Math.cos(k.ph) * k.sw) * dt;
                        if (k.y > H + 14 * d) Object.assign(k, flake(true));
                        if (k.x > W + 100 * d) k.x -= W + 200 * d;
                        else if (k.x < -100 * d) k.x += W + 200 * d;
                        const lit = Math.exp(
                            -((k.x - gx) ** 2 + (k.y - gy) ** 2) / (gr * gr),
                        );
                        const a =
                            (k.close ? 0.5 : 0.35 + 0.6 * k.z) *
                            (0.82 + 0.18 * Math.sin(k.tw + t * 3));
                        // the faster a flake falls, the more it smears along its fall
                        const ctx = k.close ? f : b,
                            wide = k.r * (k.close ? 2.3 : 1.9),
                            tall = wide * (1 + 0.9 * k.z);
                        ctx.globalAlpha = a * (1 - lit * 0.85);
                        ctx.drawImage(white, k.x - wide, k.y - tall, wide * 2, tall * 2);
                        if (lit > 0.02) {
                            ctx.globalAlpha = a * lit;
                            ctx.drawImage(green, k.x - wide, k.y - tall, wide * 2, tall * 2);
                        }
                    }
                    f.globalAlpha = b.globalAlpha = 1;
                };

                // The canvases are made for the tallest the screen gets and for
                // its width; a toolbar sliding away changes neither, so the
                // snow is not thrown away every time the page is scrolled.
                const tall = () => {
                    const probe = document.createElement("div");
                    probe.style.cssText = "position:fixed;top:0;width:0;height:100lvh;visibility:hidden";
                    document.body.append(probe);
                    const h = probe.offsetHeight;
                    probe.remove();
                    return Math.max(h, innerHeight);
                };
                const fit = () => {
                    const high = tall(),
                        key = `${innerWidth}x${high}`;
                    if (key === made) return;
                    made = key;
                    d = Math.min(devicePixelRatio || 1, coarse ? 1.5 : 2);
                    W = sky.width = far.width = front.width = Math.round(innerWidth * d);
                    H = sky.height = far.height = front.height = Math.round(high * d);
                    paintSky();
                    const want = Math.min(520, Math.round((innerWidth * high) / 3200));
                    flakes = Array.from({ length: want }, () => flake(false));
                };
                const draw = (now, dt) => {
                    if (!live) return;
                    const t = now / 1000;
                    // the aurora drifts slowly enough to be drawn every other frame
                    if (beat++ % 2 === 0) aurora(t);
                    b.clearRect(0, 0, W, H);
                    b.fillStyle = "#eaf6ff";
                    for (const s of twinkle) {
                        b.globalAlpha = 0.35 + 0.35 * Math.sin(t * s.sp + s.ph);
                        b.beginPath();
                        b.arc(s.x, s.y, s.r, 0, 6.3);
                        b.fill();
                    }
                    snow(t, dt / 1000);
                };
                return {
                    // made ahead of time, at the click, so that nothing has to be
                    // built in the instant day turns to night
                    ready: fit,
                    start() {
                        live = true;
                        beat = 0;
                        fit();
                    },
                    stop() {
                        live = false;
                    },
                    resize() {
                        if (made) fit();
                    },
                    draw,
                };
            })();

            // --- the timeline: one number, p, in milliseconds from day to night ---
            // level the cabin, then the windows light and the light keeps coming
            // out of them: small at first, then further and faster, without a
            // break, until it has the whole page; under it day is swapped for
            // night, and it clears. The swell is the slow part, while there are
            // titles left to catch; once the light has touched the far corner it
            // takes the page in a burst, so the screen is never held blank.
            const LEVEL = 700,
                SWELL = 3400,
                BURST = 420,
                SWAP = LEVEL + SWELL + BURST,
                TOTAL = SWAP + 650,
                BACK = 1.5; // the way back is the same film, run a little faster
            let p = 0,
                goal = 0,
                on = false,
                dark = false,
                raf = 0,
                then = 0;
            // how far each title is from the cabin: it catches when the light gets there
            let away = titles.map(() => Infinity);
            const measure = () => {
                const c = cabin.getBoundingClientRect(),
                    cx = c.left + c.width / 2,
                    cy = c.top + c.height / 2;
                const words = document.createRange();
                away = titles.map((el) => {
                    // the words themselves: a heading's own box runs on under the cabin
                    words.selectNodeContents(el);
                    const r = words.getBoundingClientRect(),
                        nx = Math.min(Math.max(cx, r.left), r.right),
                        ny = Math.min(Math.max(cy, r.top), r.bottom);
                    return Math.hypot(nx - cx, ny - cy);
                });
            };

            // the five windows in the picture, as fractions of it: the middle
            // of each, then half its width and half its height
            const PANES = [
                [0.304, 0.609, 0.013, 0.029],
                [0.444, 0.61, 0.025, 0.036],
                [0.603, 0.609, 0.018, 0.034],
                [0.707, 0.61, 0.016, 0.033],
                [0.6525, 0.4625, 0.02, 0.03],
            ];
            const CORE = 0.34; // how much of the light's reach is solid
            // Light does not end at an edge: past its solid middle it thins
            // out the way a glow does, quickly at first and then for a long
            // way, and it goes from white at the window to green.
            const FALL = [
                [0, 236, 255, 242, 1],
                [CORE * 0.2, 176, 255, 200, 1],
                [CORE * 0.5, 120, 255, 158, 1],
                [CORE, 104, 255, 146, 1],
                [0.42, 96, 255, 140, 0.86],
                [0.5, 84, 255, 132, 0.64],
                [0.6, 72, 250, 124, 0.4],
                [0.7, 62, 244, 118, 0.22],
                [0.8, 54, 238, 112, 0.1],
                [0.9, 48, 232, 108, 0.03],
                [1, 44, 228, 104, 0],
            ];
            if (coarse) flood.width = flood.height = 256;
            const FN = flood.width,
                fc = flood.getContext("2d");
            let drawn = "";
            // The light leaves a window, not a point. Every dot of the flood
            // is as bright as it is near to the nearest window's edge, so the
            // light starts out the shape of the windows, rounds off as it gets
            // away, and the five pools run together without a join. It is
            // worked out dot by dot on a small canvas, then stretched.
            // SHADE is FALL as a table: the colour at each distance.
            const STEPS = 1024,
                SHADE = new Uint32Array(STEPS);
            for (let i = 0, at = 1; i < STEPS; i++) {
                const d = i / (STEPS - 1);
                while (at < FALL.length - 1 && FALL[at][0] < d) at++;
                const lo = FALL[at - 1],
                    hi = FALL[at],
                    f = unit((d - lo[0]) / (hi[0] - lo[0])),
                    mix = (n) => Math.round(lo[n] + (hi[n] - lo[n]) * f);
                SHADE[i] =
                    ((Math.round((lo[4] + (hi[4] - lo[4]) * f) * 255) << 24) |
                        (mix(3) << 16) |
                        (mix(2) << 8) |
                        mix(1)) >>>
                    0;
            }
            const film = fc.createImageData(FN, FN),
                dots = new Uint32Array(film.data.buffer),
                edges = new Float32Array(PANES.length * 4),
                rise = new Float32Array(PANES.length);
            // edges: each window as left, top, right, bottom in canvas dots.
            // r: how far the light reaches. glare: how much of the window
            // itself has gone white; until then it stays a window, bars and all.
            const shine = (r, glare) => {
                const per = (STEPS - 1) / r,
                    r2 = r * r,
                    glass = ((SHADE[0] & 0xffffff) | (Math.round(glare * 255) << 24)) >>> 0,
                    n = PANES.length;
                for (let y = 0, o = 0; y < FN; y++) {
                    const py = y + 0.5;
                    for (let j = 0; j < n; j++) {
                        const dy = Math.max(edges[j * 4 + 1] - py, 0, py - edges[j * 4 + 3]);
                        rise[j] = dy * dy;
                    }
                    for (let x = 0; x < FN; x++, o++) {
                        const px = x + 0.5;
                        let near = r2;
                        for (let j = 0; j < n; j++) {
                            const dx = Math.max(edges[j * 4] - px, 0, px - edges[j * 4 + 2]),
                                d = dx * dx + rise[j];
                            if (d < near) near = d;
                        }
                        dots[o] = near === 0 ? glass : near < r2 ? SHADE[(Math.sqrt(near) * per) | 0] : 0;
                    }
                }
                fc.putImageData(film, 0, 0);
            };

            const apply = () => {
                const ms = p - LEVEL, // how long the light has been on
                    night = p >= SWAP,
                    w = panes.getBoundingClientRect();
                if (night !== dark) {
                    dark = night;
                    root.classList.toggle("night", night);
                    night ? scene.start() : scene.stop();
                }
                root.classList.toggle("level", p > 0);

                // the windows come on, with the glow round the cabin behind them
                panes.style.opacity = night ? 0 : ease(unit(ms / 450)).toFixed(3);
                halo.style.opacity = night ? 0.72 : (0.9 * ease(unit(ms / 1600))).toFixed(3);

                // the flood: one pool of light on each window. They never stop
                // growing; they run together, spread out of the cabin and cross
                // the page at a pace that lets each title catch just ahead of the
                // front of the light, well before the solid middle arrives.
                const cx = w.left + w.width / 2,
                    cy = w.top + w.height * 0.6,
                    far =
                        Math.hypot(Math.max(cx, innerWidth - cx), Math.max(cy, innerHeight - cy)) +
                        w.width * 0.3,
                    small = w.width * 0.008,
                    // the swell carries the rim of the light to the far corner;
                    // the burst carries the solid middle there, picking up at
                    // the speed the swell left off
                    u = unit(ms / SWELL),
                    v = unit((ms - SWELL) / BURST),
                    turn = (3 * BURST) / SWELL,
                    reach =
                        small +
                        (far - small) * u * u * u +
                        far * (turn * v + (1 / CORE - 1 - turn) * v * v);
                titles.forEach((el, i) =>
                    el.classList.toggle("lit", ms > 0 && reach * 1.15 >= away[i]),
                );
                // it clears quickly at first: night shows at once
                const veil = night ? Math.pow(1 - unit((p - SWAP) / (TOTAL - SWAP)), 2) : 1;
                const a = ease(unit(ms / 600)) * veil;
                if (a < 0.004) {
                    box.style.display = "none";
                    return;
                }
                // the canvas always holds just the square the pools fill, however
                // large that square is on the page
                const half = reach + w.width * 0.25,
                    k = FN / (2 * half),
                    r = reach * k,
                    key = `${reach.toFixed(1)} ${w.width.toFixed(1)}`;
                if (key !== drawn) {
                    drawn = key;
                    const glare = ease(unit((reach - w.width * 0.03) / (w.width * 0.1)));
                    PANES.forEach(([x, y, hw, hh], j) => {
                        edges[j * 4] = FN / 2 + (w.left + w.width * (x - hw) - cx) * k;
                        edges[j * 4 + 1] = FN / 2 + (w.top + w.height * (y - hh) - cy) * k;
                        edges[j * 4 + 2] = FN / 2 + (w.left + w.width * (x + hw) - cx) * k;
                        edges[j * 4 + 3] = FN / 2 + (w.top + w.height * (y + hh) - cy) * k;
                    });
                    shine(r, glare);
                }
                box.style.display = "block";
                flood.style.opacity = a.toFixed(3);
                flood.style.transform =
                    `translate(${(cx - half).toFixed(1)}px, ${(cy - half).toFixed(1)}px) scale(${(1 / k).toFixed(4)})`;
            };

            const frame = (now) => {
                raf = 0;
                // a slow frame skips ahead rather than stretching the film
                const dt = Math.min(now - then, 100);
                then = now;
                if (p !== goal) {
                    p = goal > p ? Math.min(goal, p + dt) : Math.max(goal, p - dt * BACK);
                    apply();
                }
                if (dark) scene.draw(now, dt);
                if (p !== goal || dark) wake();
            };
            const wake = () => {
                if (raf) return;
                raf = requestAnimationFrame((now) => {
                    if (!then || now - then > 200) then = now - 16;
                    frame(now);
                });
            };
            // with motion turned down there is no film: day, or night with the snow held still
            const jump = () => {
                p = goal;
                apply();
                scene.draw(performance.now(), 0);
            };

            addEventListener("resize", () => {
                scene.resize();
                if (still) scene.draw(performance.now(), 0);
            });
            addEventListener("keydown", (e) => {
                if (e.key === "Escape" && on) cabin.click();
            });
            cabin.addEventListener("click", () => {
                cabin.blur();
                if (p === 0) {
                    measure();
                    scene.ready();
                }
                on = !on;
                goal = on ? TOTAL : 0;
                cabin.setAttribute("aria-pressed", String(on));
                still ? jump() : wake();
            });

            // ?fps on the address shows how the frames are going, for a phone
            // that cannot be asked any other way
            if (location.search.includes("fps")) {
                const meter = document.body.appendChild(document.createElement("pre"));
                meter.style.cssText =
                    "position:fixed;left:6px;top:6px;z-index:99;margin:0;padding:4px 6px;" +
                    "font:11px/1.3 monospace;background:#000c;color:#0f0;pointer-events:none";
                let n = 0,
                    worst = 0,
                    since = performance.now(),
                    last = since;
                const count = (now) => {
                    n++;
                    worst = Math.max(worst, now - last);
                    last = now;
                    if (now - since >= 1000) {
                        const part = p === 0 ? "day" : p < SWAP ? "swell" : p < TOTAL ? "clearing" : "night";
                        meter.textContent =
                            `${n} fps, worst ${worst.toFixed(0)} ms\n` +
                            `${part} ${innerWidth}x${innerHeight} @${devicePixelRatio}`;
                        n = worst = 0;
                        since = now;
                    }
                    requestAnimationFrame(count);
                };
                requestAnimationFrame(count);
            }
        })();
    </script>
</Base>
